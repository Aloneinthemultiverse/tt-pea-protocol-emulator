; Firmware for the PEA protocol emulator. Each program runs on one engine.

.program uart_tx
; UART 8N1 transmitter. Tick = half a bit. side pin = out pin = TX. LSB first (out_right).
; Wrap from the last instruction back to the first.
        pull            side 1      ; idle high; wait for a byte
        set x 7         side 0 [1]  ; start bit
bit:    out pins 1
        jmp x-- bit
        nop             side 1 [1]  ; stop bit

.program uart_rx
; UART 8N1 receiver on pin 1. Tick = half a bit; the start edge re-aligns the divider.
start:  wait 0 pin 1 resync         ; start bit; next tick is half a bit later
        set x 7         [1]         ; middle of start bit, then one bit to bit 0
bit:    in pins 1
        jmp x-- bit
        push noblock                ; middle of stop bit
        jmp start

.program spi_master
; SPI master, mode 0, MSB first, full duplex: two instructions per bit, autopull + autopush.
; side pin = SCK, out pin = MOSI, in pin = MISO. Wrap the two lines.
        out pins 1      side 0
        in pins 1       side 1

.program i2c_master
; I2C master write with ACK capture and clock stretching. Tick = quarter bit.
; Open-drain SDA = pin 5 (set/out/in base), SCL = pin 6 (side). Host sends n-1, then n bytes.
; The RX FIFO gets one byte per data byte: 0 = ACK, 1 = NACK.
start:  pull
        mov x osr
        set pins 0      [1]         ; START: SDA falls while SCL is high
byte:   pull            side 0
        set y 7
bit:    out pins 1      side 0
        wait 1 pin 6    side 1      ; release SCL and wait for it (the slave may stretch)
        nop
        jmp y-- bit     side 0
        set pins 1      side 0      ; release SDA for the ACK bit
        wait 1 pin 6    side 1
        in pins 1
        push noblock    side 0
        jmp x-- byte    side 0
        set pins 0      side 0
        nop             side 1 [1]
        set pins 1      [1]         ; STOP: SDA rises while SCL is high
        jmp start

.program nrzi_tx
; NRZI transmitter with bit stuffing and CRC (USB-style line coding). Tick = bit/3.
; Host sends bit count-1, then the data bytes, then sets flag 7. Sends a sync transition,
; then the bits. Afterwards pushes CRC low, CRC high and raises flag 0.
tx:     pull
        mov x osr
        out null 8
        mov crc ~null               ; CRC = 0xFFFF
        set ctl 6                   ; CRC on OUT bits, clear the run counter
        wait 1 flag 7
        set nrzi 0      [2]         ; sync transition
bit:    out nrzi 1
        jmp stuff ins
        jmp x-- bit
        jmp fin
ins:    nop
        set nrzi 0                  ; stuffed 0 (a transition), not in the CRC
        nop
        jmp x-- bit
fin:    set ctl 0
        mov isr crclo
        push
        mov isr crchi
        push
        set flag 8                  ; flag 0 = 1
        jmp tx

.program nrzi_rx
; NRZI receiver with destuffing and CRC on pin 7. Tick = bit/3, resync_half, autopush.
; Host sends bit count-1. Pushes the data bytes, then CRC low, CRC high, and raises flag 1.
rx:     pull
        mov x osr
        mov crc ~null
        set ctl 5                   ; CRC on IN bits, clear the run counter
        wait 1 anyedge 7 resync     ; sync transition
        in nrzi 1 discard [3]       ; latch the line level; the next sample is mid bit 0
bit:    in nrzi 1
        jmp stuff skip
        jmp x-- bit
        jmp fin
skip:   nop
        in nrzi 1 discard           ; drop the stuffed bit
        nop
        jmp x-- bit
fin:    set ctl 0
        mov isr crclo
        push
        mov isr crchi
        push
        set flag 9                  ; flag 1 = 1
        jmp rx

.program spi_mode2
; SPI master, mode 2 (CPOL=1, CPHA=0): mode 0 with the clock inverted. SCK idles high.
        out pins 1      side 1
        in pins 1       side 0

.program spi_mode1
; SPI master, mode 1 (CPOL=0, CPHA=1): data changes on the rising edge, sampled on the falling
; edge. An explicit loop keeps SCK low while waiting for data. Autopush, no autopull.
        pull            side 0
        set x 7         side 0
bit:    out pins 1      side 1
        in pins 1       side 0
        jmp x-- bit     side 0

.program spi_mode3
; SPI master, mode 3 (CPOL=1, CPHA=1): mode 1 with the clock inverted. SCK idles high.
        pull            side 1
        set x 7         side 1
bit:    out pins 1      side 0
        in pins 1       side 1
        jmp x-- bit     side 1

.program i2c_read
; I2C master read with clock stretching. Tick = quarter bit. SDA = pin 5, SCL = pin 6 (side).
; Host sends n-1, then the address byte with R/W = 1. RX FIFO gets the address ACK bit
; (0 = ACK), then n data bytes. The master ACKs every byte except the last, which it NACKs.
start:  pull
        mov x osr
        set pins 0      [1]         ; START
        pull            side 0
        set y 7
abit:   out pins 1      side 0
        wait 1 pin 6    side 1
        nop
        jmp y-- abit    side 0
        set pins 1      side 0      ; release SDA for the address ACK
        wait 1 pin 6    side 1
        in pins 1
        push noblock    side 0
rbyte:  set y 7         side 0
rbit:   nop             side 0      ; the slave drives SDA while SCL is low
        wait 1 pin 6    side 1
        in pins 1
        jmp y-- rbit    side 0
        push noblock    side 0
        jmp !x nack     side 0
        set pins 0      side 0      ; ACK
        wait 1 pin 6    side 1
        nop
        nop             side 0
        set pins 1      side 0      ; release SDA after SCL falls
        jmp x-- rbyte   side 0
nack:   wait 1 pin 6    side 1      ; SDA released: NACK
        nop
        nop             side 0
        set pins 0      side 0      ; SDA low while SCL low, then STOP
        nop             side 1 [1]
        set pins 1      [1]
        jmp start

.program jtag
; JTAG master: TCK = side pin, out pins 2 = {TMS, TDI} (bit 0 TDI, bit 1 TMS), TDO = in pin.
; Every host byte is 4 TCK cycles, LSB first, so the host walks the full TAP state machine.
; Every 8 cycles one TDO byte is pushed (blocking: TCK stops low until the host reads).
start:  set y 7
bit:    out pins 2      side 0
        in pins 1       side 1
        jmp y-- bit     side 1
        push            side 0

.program swd_read
; SWD read transaction: SWCLK = side pin, SWDIO = one pin (set/out/in base, direction flips).
; Host sends the 8-bit request. RX FIFO: ACK in bits 7:5, 4 data bytes LSB first, parity in bit 7.
start:  pull            side 0
        set pindirs 1   side 0
        set y 7
req:    out pins 1      side 0
        jmp y-- req     side 1
        set pindirs 0   side 0      ; turnaround: release SWDIO
        nop             side 1
        set y 2         side 0
ack:    in pins 1       side 0
        jmp y-- ack     side 1
        push            side 0
        set x 3
dbyte:  set y 7
dbit:   in pins 1       side 0
        jmp y-- dbit    side 1
        push            side 0
        jmp x-- dbyte   side 0
        in pins 1       side 0      ; parity
        nop             side 1      ; turnaround back to the host
        push            side 0
        set pindirs 1   side 0

.program spi_target
; SPI target (slave), mode 0, MSB first. Pins are inputs from the external controller:
; SCK and CSn by absolute pin number in WAIT, MOSI = in pin, MISO = out pin, jmp pin = CSn.
; Autopull/autopush 8. Entry at the first word (preloads MISO bit 7); wrap from `bit` to the end.
        out pins 1                  ; first MISO bit, before the first SCK edge
start:  wait 0 pin 1                ; CSn low
bit:    wait 1 pin 0                ; SCK rises: sample MOSI
        in pins 1
        wait 0 pin 0                ; SCK falls: shift out the next MISO bit
        out pins 1
        jmp pin start               ; CSn high: transaction over

.program ws2812
; WS2812 / NeoPixel LED chain, 800 kHz. Tick = bit/8 (156 ns). Side pin = data line.
; '0': 2 ticks high, 6 low. '1': 5 high, 3 low. Autopull 8, MSB first (G, R, B per LED).
; With no data the line stays low, which latches the LEDs.
bit:    out x 1         side 0 [2]
        jmp !x zero     side 1 [1]
        jmp bit         side 1 [2]
zero:   nop             side 0 [2]

.program onewire
; 1-Wire controller. Tick = 3 us. One open-drain pin (set base = in base).
; Entry: reset pulse + presence detect, then byte "touch" slots on every TX byte: each bit is
; written LSB first and the bus is sampled in the same slot, so writing 0xFF reads a byte.
; RX: presence byte (bit 7 = 0: a device answered), then one byte per TX byte.
; Wrap: bit .. end.
        set pins 0
        set y 39
rst:    jmp y-- rst     [3]         ; 480 us reset pulse
        set pins 1
        set y 5
pw:     jmp y-- pw      [3]         ; ~72 us, then sample presence
        in pins 1
        push
        set y 39
rw:     jmp y-- rw      [3]
bit:    out x 1                     ; waits here, bus idle, for the next byte
        set pins 0                  ; slot start
        jmp !x zero
        set pins 1                  ; write 1 / read: release after 6 us
zero:   nop
        in pins 1                   ; sample at 9-12 us
        set y 3         [3]
hold:   jmp y-- hold    [3]
        set pins 1                  ; end of slot (~72 us low for a 0)
        nop             [3]         ; recovery

.program can_tx
; CAN 2.0 transmitter with on-chip bit stuffing and CRC-15. Tick = bit/8. TX = out/set pin,
; RX (the bus, via the transceiver) = in pin. Stuff mode = equal bits, stuff_n = 5,
; CRC width 15, polynomial 0x4599, CRC on OUT bits.
; Host sends n-2 (n = SOF..data bits), then the bits MSB first. The engine stuffs, appends
; CRC-15 (stuffed), delimiter, samples the ACK slot (RX FIFO bit 0: 0 = acknowledged), then EOF.
; Every bit, including stuff bits, is exactly 8 ticks. Wrap: start .. eof.
start:  pull
        mov x osr
        out null 8
        mov crc null
        set ctl 6                   ; CRC on OUT bits, clear the run counter
bit:    jmp stuff ins0
        out pins 1      [3]
        jmp x-- bit     [2]
l1:     jmp stuff ins1
        out pins 1                  ; last data bit
        set ctl 0
        mov osr crchi
        out null 1                  ; CRC-15: drop bit 15
        set x 5         [2]
cbit:   jmp stuff insc
        out pins 1      [3]
        jmp x-- cbit    [2]
l2:     jmp stuff ins2
        out pins 1
        mov osr crclo   [1]
        set x 6         [3]
dbit:   jmp stuff insd
        out pins 1      [3]
        jmp x-- dbit    [2]
l3:     jmp stuff ins3
        out pins 1      [3]         ; last CRC bit
        mov isr null    [2]
l4:     jmp stuff ins4              ; a stuff bit may follow the CRC
        set pins 1      [3]         ; CRC delimiter
        nop             [3]
        nop             [3]         ; ACK slot: stay recessive, sample mid-bit
        in pins 1
        push            [2]
        set y 21
eof:    jmp y-- eof     [3]         ; ACK delimiter, EOF, intermission
ins0:   mov pins ~pins  [3]         ; stuff bit = complement of the last bit
        in pins 1       [1]         ; let the run counter see it
        jmp bit
ins1:   mov pins ~pins  [3]
        in pins 1       [1]
        jmp l1
insc:   mov pins ~pins  [3]
        in pins 1       [1]
        jmp cbit
ins2:   mov pins ~pins  [3]
        in pins 1       [1]
        jmp l2
insd:   mov pins ~pins  [3]
        in pins 1       [1]
        jmp dbit
ins3:   mov pins ~pins  [3]
        in pins 1       [1]
        jmp l3
ins4:   mov pins ~pins  [3]
        in pins 1       [1]
        jmp l4

.program usb_rx
; Low-speed USB receiver (1.5 Mbit/s). D- = pin 6 (in base, NRZI input), D+ = pin 7.
; Tick = bit/3, auto_resync + resync_half, autopush, LSB first, diff mode (jmp pin = SE0 on 6,7).
; Packets of any length: SYNC is skipped, the PID and every byte are pushed, the end is found
; by SE0. At EOP the CRC-16 residual over the bytes after the PID is pushed (low, high);
; 0x800D means a data packet arrived intact. Then flags 1 and 2 are raised.
; Wrap: bit .. (jmp pin eop).
rx:     wait 0 edge 6 resync        ; J -> K: start of SYNC
        in nrzi 1 discard           ; latch the line level
        set y 6
        set x 7
        set ctl 5                   ; CRC on IN bits, clear the run counter
sy:     in nrzi 1 discard           ; rest of SYNC
        jmp y-- sy      [1]
pid:    in nrzi 1                   ; PID: 8 bits, CRC held at its start value
        mov crc ~null
        jmp x-- pid
bit:    in nrzi 1
        jmp stuff skip
        jmp pin eop                 ; SE0: end of packet
skip:   nop
        in nrzi 1 discard           ; drop the stuffed bit
        nop
        jmp bit
eop:    set ctl 0
        mov isr crclo
        push
        mov isr crchi
        push
        set flag 9                  ; flag 1: packet received (transmit engine)
        set flag 10                 ; flag 2: packet received (handshake engine)
        wait 1 pin 6                ; back to J
        jmp rx

.program usb_ack
; Handshake engine: after the SETUP token and the DATA0 packet, answers ACK within ~3 bit times.
; Tick = bit/4. D- = out/set base (pin 6), diff, MSB first. Host preloads [15, 0x01, 0x4B]
; (SYNC and the ACK PID, bit-reversed for MSB-first output).
        pull
        mov x osr                   ; 16 bits - 1
        pull                        ; SYNC held in OSR
        set y 1
aw:     wait 1 flag 2               ; SETUP token, then DATA0
        set flag 2      [3]
        jmp y-- aw      [3]         ; ~2 bit times: lets the receiver re-arm first
        set pindirs 3               ; drive D-, D+
abit:   out nrzi 1      [1]
        jmp x-- abit    [1]
        set pins 0      [3]         ; EOP: SE0 for 2 bits
        nop             [3]
        set pins 1      [3]         ; J
        set pindirs 0               ; release the bus
park:   wait 1 flag 7               ; done; the host re-arms by writing the PC

.program usb_tx
; Data engine: answers the IN token with DATA1 + payload + CRC-16 (computed on chip), with bit
; stuffing and EOP. Tick = bit/4, every bit (stuff bits too) is exactly 4 ticks.
; D- = out/set base (pin 6), diff, MSB first; the host bit-reverses bytes.
; Host preloads [data bits - 2, PID, 8 payload bytes] (the payload fills the 8-deep FIFO; SYNC is
; generated in code, the PID waits in the OSR). Flag 1 counts packets on the bus:
; SETUP, DATA0, our ACK, IN -> transmit. Afterwards the engine parks; the host re-arms it via the PC.
start:  pull
        mov x osr                   ; data bits - 2
        pull                        ; PID held in OSR
        set y 3
w:      wait 1 flag 1
        set flag 1
        jmp y-- w
        set y 6         [3]
        set ctl 2       [3]         ; CRC on OUT bits; delays let the receiver re-arm
        set pindirs 3
sync:   set nrzi 0      [1]         ; SYNC: seven 0s (transitions) ...
        jmp y-- sync    [1]
        set nrzi 1                  ; ... and a 1
        set y 7         [2]         ; PID: 8 bits
hbit:   out nrzi 1                  ; header: CRC kept at its start value
        mov crc ~null
        jmp y-- hbit    [1]
dbit:   out nrzi 1
        jmp stuff dins
dchk:   set y 6
        jmp x-- dbit
dlast:  out nrzi 1
        jmp stuff lins
        set ctl 0
        mov osr ~crchi              ; CRC is sent inverted, MSB first
cbit:   out nrzi 1
        jmp stuff cins
cchk:   set x 6
        jmp y-- cbit
clast:  out nrzi 1
        jmp stuff clins
        mov osr ~crclo  [1]
ebit:   out nrzi 1
        jmp stuff eins
echk:   nop
        jmp x-- ebit
elast:  out nrzi 1
        jmp stuff elins
        nop             [1]
eop:    set pins 0      [3]         ; SE0 for 2 bits
        nop             [3]
        set pins 1      [3]         ; J
        set pindirs 0
park:   wait 1 flag 7               ; done
dins:   nop             [1]
        set nrzi 0                  ; stuffed 0
        jmp dchk
lins:   set ctl 0
        mov osr ~crchi
        set nrzi 0      [2]
        jmp cbit
cins:   nop             [1]
        set nrzi 0
        jmp cchk
clins:  mov osr ~crclo
        nop
        set nrzi 0      [2]
        jmp ebit
eins:   nop             [1]
        set nrzi 0
        jmp echk
elins:  nop             [1]
        set nrzi 0      [2]
        jmp eop
