        check(q[0] === 1'b0, "CAN: frame 1 ACK seen by the engine");
        can_send(11'h5A5, 4'd2, 16'h3CC3);
        #150000; erd(0, 4'hD, q);
        check(c_frames == 2 && c_crcok == 2 && c_id == 11'h5A5 && c_data == 16'h3CC3 && q[0] === 1'b0,
