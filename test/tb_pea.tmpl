        wmark("SPI target");
        // MOSI pin 2 and reads MISO on pin 3
        pm_clear;
//@PROG spi_target 0
        pm_load;
        ext_sel = 1; wr(7'h06, 8'h00); wr(7'h07, 8'h08); #200;
