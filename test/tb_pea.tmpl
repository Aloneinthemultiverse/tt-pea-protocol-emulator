        bad = 0;
        for (it = 0; it < 4; it = it + 1) begin
            for (ne = 0; ne < 2; ne = ne + 1) begin rb[ne] = $random(seed); rt[ne] = $random(seed); end
            if (it == 0) begin rb[0] = 8'hA1; rt[0] = 8'hC3; end
