// Self-checking testbench for the PEA protocol emulator (generated from tb_pea.tmpl by
// test/gen_tb.py, which embeds the assembled firmware). Protocol partners are independent
// behavioural models: a UART monitor/driver, an SPI slave, an I2C slave with ACK/NACK and
// clock stretching, and an NRZI + bit-stuffing + CRC-16 reference coder.
`timescale 1ns/1ps
module tb_pea;
    reg clk = 0, rst_n = 0;
    always #10 clk = ~clk;                       // 50 MHz

    reg sclk = 0, csn = 1, mosi = 0;
    wire [7:0] uo_out, uio_out, uio_oe;
    wire miso = uo_out[0];
    wire [7:0] line = uio_out | ~uio_oe;         // released pins read high (pull-ups)

    reg  tb_utx = 1, urx_sel = 0, tb_nrzi = 1, nrzi_sel = 0;
    reg  s_miso = 1, sl_sda_low = 0, sl_scl_low = 0;
    wire sda = line[5] & ~sl_sda_low;
    wire scl = line[6] & ~sl_scl_low;
    reg  jtag_sel = 0, swd_sel = 0, tdo = 0, sw_drive = 0, sw_bit = 1;
    wire swdio = sw_drive ? sw_bit : line[1];
    reg  usb_sel = 0, h_oe = 0, h_dp = 0, h_dm = 1;
    wire usb_dm = uio_oe[6] ? uio_out[6] : h_oe ? h_dm : 1'b1;
    wire usb_dp = uio_oe[7] ? uio_out[7] : h_oe ? h_dp : 1'b0;
    reg  can_sel = 0, can_ack = 0, ow_sel = 0, ws_sel = 0;
    wire can_bus = line[0] & ~can_ack;           // CAN bus: TX pin wired-AND with the receiver's ACK
    reg  ext_sel = 0, m_sck = 0, m_csn = 1, m_mosi = 0;     // external SPI controller (target test)
    wire [7:0] uio_in = {usb_sel ? usb_dp : nrzi_sel ? tb_nrzi : line[7], usb_sel ? usb_dm : scl, sda, jtag_sel ? tdo : s_miso, line[3],
                         ext_sel ? m_mosi : line[2],
                         ext_sel ? m_csn : swd_sel ? swdio : can_sel ? can_bus : urx_sel ? tb_utx : line[0],
                         ext_sel ? m_sck : line[0]};

    tt_um_auralis_pea dut (.ui_in({5'd0, mosi, csn, sclk}), .uo_out(uo_out), .uio_in(uio_in),
                           .uio_out(uio_out), .uio_oe(uio_oe), .ena(1'b1), .clk(clk), .rst_n(rst_n));

    // waveform log for docs/waveforms (test/plot_waves.py): every change of the 8 bidirectional pins
    // as seen on the wire (driven by the chip, else by the external model), plus section markers
    wire [7:0] wf_bus = (uio_oe & uio_out) | (~uio_oe & uio_in);
    integer wf;
    initial wf = $fopen("waves.txt", "w");
    always @(wf_bus) $fdisplay(wf, "%0d %h", $time, wf_bus);
    task wmark(input [8*24-1:0] name);
        $fdisplay(wf, "M %0d %0s", $time, name);
    endtask

    integer fails = 0, checks = 0;
    task check(input cond, input [8*40-1:0] name);
        begin
            checks = checks + 1;
            if (cond) $display("PASS %0s", name);
            else begin $display("FAIL %0s", name); fails = fails + 1; end
        end
    endtask

    // ---------------- SPI host
    task spi_byte(input [7:0] d, output [7:0] q);
        integer k;
        begin
            for (k = 7; k >= 0; k = k - 1) begin
                mosi = d[k]; #80; sclk = 1; q[k] = miso; #80; sclk = 0;
            end
        end
    endtask
    reg [7:0] junk;
    task wr(input [6:0] a, input [7:0] d);
        begin csn = 0; #80; spi_byte({1'b1, a}, junk); spi_byte(d, junk); #80; csn = 1; #160; end
    endtask
    task rd(input [6:0] a, output [7:0] q);
        begin csn = 0; #80; spi_byte({1'b0, a}, junk); spi_byte(8'h00, q); #80; csn = 1; #160; end
    endtask
    task ecfg(input integer e, input [3:0] r, input [7:0] d);
        begin wr(7'h10 + e * 16 + {3'd0, r}, d); end
    endtask
    task erd(input integer e, input [3:0] r, output [7:0] q);
        begin rd(7'h10 + e * 16 + {3'd0, r}, q); end
    endtask

    reg [15:0] pm [0:127];
    integer pi;
    task pm_clear;
        begin for (pi = 0; pi < 128; pi = pi + 1) pm[pi] = 16'h0000; end
    endtask
    task pm_load;
        begin
            wr(7'h00, 8'h00); wr(7'h02, 8'h00); wr(7'h03, 8'h00);
            csn = 0; #80; spi_byte(8'h84, junk);
            for (pi = 0; pi < 128; pi = pi + 1) begin spi_byte(pm[pi][7:0], junk); spi_byte(pm[pi][15:8], junk); end
            #80; csn = 1; #160;
        end
    endtask
    // engine e: divider, pin registers, wrap, shift thresholds, mode, entry point
    task esetup(input integer e, input [15:0] div, input [7:0] frac, input [7:0] p0, input [7:0] p1,
                input [7:0] p2, input [5:0] wb, input [5:0] wt, input [7:0] mode, input [5:0] entry);
        begin
            ecfg(e, 4'h0, frac); ecfg(e, 4'h1, div[7:0]); ecfg(e, 4'h2, div[15:8]);
            ecfg(e, 4'h3, p0); ecfg(e, 4'h4, p1); ecfg(e, 4'h5, p2);
            ecfg(e, 4'h6, {2'd0, wb}); ecfg(e, 4'h7, {2'd0, wt}); ecfg(e, 4'h8, 8'h00);
            ecfg(e, 4'h9, mode); ecfg(e, 4'hF, {2'd0, entry});
        end
    endtask

    // ---------------- UART models (115200 baud)
    real BIT = 8680.556;
    reg [7:0] mon;
    task uart_mon(output [7:0] b);
        integer k;
        begin
            @(negedge line[0]); #(BIT * 1.5);
            for (k = 0; k < 8; k = k + 1) begin b[k] = line[0]; #(BIT); end
            if (line[0] !== 1'b1) b = 8'hxx;      // stop bit must be high
        end
    endtask
    task uart_send(input [7:0] b, input real bitns);
        integer k;
        begin
            tb_utx = 0; #(bitns);
            for (k = 0; k < 8; k = k + 1) begin tb_utx = b[k]; #(bitns); end
            tb_utx = 1; #(bitns * 2);
        end
    endtask

    // ---------------- SPI slave model (all four modes, MSB first; s_mode = {CPOL, CPHA})
    reg [7:0] s_rx [0:3];
    reg [7:0] s_tx [0:3];
    reg [7:0] s_sh;
    reg [1:0] s_mode = 0;
    integer s_bits = 0;
    wire s_ck = line[2] ^ s_mode[1];             // leading edge is always a rising s_ck
    task s_sample; begin
        s_sh = {s_sh[6:0], line[3]};
        s_bits = s_bits + 1;
        if (s_bits % 8 == 0) s_rx[s_bits / 8 - 1] = s_sh;
    end endtask
    task s_drive; s_miso = s_tx[(s_bits / 8) % 4][7 - (s_bits % 8)]; endtask
    always @(posedge s_ck) if (s_mode[0]) s_drive; else s_sample;
    always @(negedge s_ck) if (s_mode[0]) s_sample; else s_drive;

    // ---------------- I2C slave model: write (ACKs byte 0, NACKs byte 1, stretches the clock)
    // and read (address LSB = 1: sends i_dat[], records the master ACK/NACK in i_mack[])
    reg [7:0] i_rx [0:3];
    reg [7:0] i_dat [0:3];
    reg [7:0] i_sh;
    reg [3:0] i_mack;
    integer i_bit = 0, i_n = 0, i_k = 0, i_stretches = 0;
    reg i_active = 0, i_stop = 0, i_rd = 0;
    always @(negedge sda) if (scl) begin i_active = 1; i_bit = 0; end
    always @(posedge sda) if (scl && i_active) begin i_active = 0; i_stop = 1; end
    always @(posedge scl) if (i_active) begin
        if (i_bit < 8) begin i_sh = {i_sh[6:0], sda}; i_bit = i_bit + 1; end
        else if (i_rd) begin                     // master ACK (0) or NACK (1) after a read byte
            i_mack[i_k] = sda; i_k = i_k + 1; if (sda) i_rd = 0; i_bit = 9;
        end else begin
            i_rx[i_n] = i_sh; i_n = i_n + 1; i_bit = 9;
            if (i_n == 1 && i_sh[0]) i_rd = 1;   // read address: slave transmits next
        end
    end
    always @(negedge scl) if (i_active) begin
        if (i_bit == 8) begin
            if (i_rd) sl_sda_low = 0;            // release SDA for the master's ACK
            else begin
                sl_sda_low = (i_n == 0);         // ACK the first byte only
                sl_scl_low = 1; i_stretches = i_stretches + 1;
                #3000 sl_scl_low = 0;            // hold SCL low: clock stretching
            end
        end else if (i_bit == 9) begin
            sl_sda_low = i_rd ? !i_dat[i_k][7] : 1'b0; i_bit = 0;
        end else if (i_rd && i_bit > 0) sl_sda_low = !i_dat[i_k][7 - i_bit];
    end

    // ---------------- JTAG TAP model (IEEE 1149.1 state machine, 4-bit IR, IDCODE + BYPASS)
    // TCK pin 0, TDI pin 1, TMS pin 2, TDO -> pin 4
    localparam [31:0] IDCODE = 32'h1BEEF0D3;
    reg [3:0] tap = 0, ir = 4'h1, irsh = 0;
    reg [31:0] drsh = 0;
    wire tms = line[2], tdi = line[1];
    always @(posedge line[0]) if (jtag_sel) begin
        case (tap)
            4'd0: ir = 4'h1;                                    // Test-Logic-Reset: IDCODE
            4'd3: drsh = (ir == 4'h1) ? IDCODE : 32'd0;         // Capture-DR
            4'd4: drsh = (ir == 4'h1) ? {tdi, drsh[31:1]} : {31'd0, tdi};   // Shift-DR
            4'd10: irsh = 4'b0001;                              // Capture-IR
            4'd11: irsh = {tdi, irsh[3:1]};                     // Shift-IR
            4'd15: ir = irsh;                                   // Update-IR
            default: ;
        endcase
        case (tap)
            4'd0: tap = tms ? 4'd0 : 4'd1;    4'd1: tap = tms ? 4'd2 : 4'd1;
            4'd2: tap = tms ? 4'd9 : 4'd3;    4'd3: tap = tms ? 4'd5 : 4'd4;
            4'd4: tap = tms ? 4'd5 : 4'd4;    4'd5: tap = tms ? 4'd8 : 4'd6;
            4'd6: tap = tms ? 4'd7 : 4'd6;    4'd7: tap = tms ? 4'd8 : 4'd4;
            4'd8: tap = tms ? 4'd2 : 4'd1;    4'd9: tap = tms ? 4'd0 : 4'd10;
            4'd10: tap = tms ? 4'd12 : 4'd11; 4'd11: tap = tms ? 4'd12 : 4'd11;
            4'd12: tap = tms ? 4'd15 : 4'd13; 4'd13: tap = tms ? 4'd14 : 4'd13;
            4'd14: tap = tms ? 4'd15 : 4'd11; default: tap = tms ? 4'd2 : 4'd1;
        endcase
    end
    always @(negedge line[0]) if (jtag_sel) tdo = (tap == 4'd11) ? irsh[0] : drsh[0];

    // ---------------- SWD target model: SWCLK pin 0, SWDIO pin 1. Answers a read with ACK OK.
    localparam [31:0] SWD_DATA = 32'h2BA01477;
    reg [7:0] sw_req = 0;
    integer sw_r = 0;
    always @(posedge line[0]) if (swd_sel) begin
        if (sw_r < 8) sw_req = {line[1], sw_req[7:1]};
        if (sw_r == 8) begin sw_drive = 1; sw_bit = 1; end           // ACK = 001, LSB first
        else if (sw_r == 9 || sw_r == 10) sw_bit = 0;
        else if (sw_r >= 11 && sw_r <= 42) sw_bit = SWD_DATA[sw_r - 11];
        else if (sw_r == 43) sw_bit = ^SWD_DATA;                    // parity
        else if (sw_r == 44) sw_drive = 0;                          // turnaround
        sw_r = sw_r + 1;
    end

    // external SPI controller for the target test: 1 MHz, mode 0
    task m_xfer(input [7:0] d, output [7:0] qq);
        integer b;
        for (b = 7; b >= 0; b = b - 1) begin
            m_mosi = d[b]; #500; m_sck = 1; qq[b] = line[3]; #500; m_sck = 0;
        end
    endtask

    // CAN host side: build SOF..data, send n-2 then the bits MSB first
    reg [63:0] cf; integer cfn, cfb;
    task can_send(input [10:0] id, input [3:0] dlc, input [15:0] d);
        begin
            cf = 0; cfn = 1;                                             // SOF = 0
            for (cfb = 10; cfb >= 0; cfb = cfb - 1) begin cf[63 - cfn] = id[cfb]; cfn = cfn + 1; end
            cfn = cfn + 3;                                               // RTR, IDE, r0 = 0
            for (cfb = 3; cfb >= 0; cfb = cfb - 1) begin cf[63 - cfn] = dlc[cfb]; cfn = cfn + 1; end
            for (cfb = 8 * dlc - 1; cfb >= 0; cfb = cfb - 1) begin cf[63 - cfn] = d[cfb]; cfn = cfn + 1; end
            ecfg(0, 4'hD, cfn - 2);
            for (cfb = 0; cfb < (cfn + 7) / 8; cfb = cfb + 1) begin
                ecfg(0, 4'hD, cf[63 - 8 * cfb -: 8]);
                if (cfb == 2) #8000;
            end
        end
    endtask

    // ---------------- USB low-speed host model (1.5 Mbit/s): NRZI, bit stuffing, SE0 EOP, CRC-16
    real UB = 666.667;
    reg [7:0] hb [0:15];                         // packet to send (after SYNC), LSB first on the wire
    reg [7:0] rb_ [0:15]; integer r_nb;          // received packet bytes (PID first)
    reg [15:0] r_res;                            // CRC-16 residual of a received data packet
    realtime h_eop_t, d_sop_t;
    function [7:0] rev8(input [7:0] v);
        integer i; begin for (i = 0; i < 8; i = i + 1) rev8[i] = v[7 - i]; end
    endfunction
    task h_send(input integer nb);               // SYNC + hb[0..nb-1], then EOP
        integer k, i, ones; reg st, b;
        begin
            h_oe = 1; st = 1; ones = 0;
            for (k = -1; k < nb; k = k + 1)
                for (i = 0; i < 8; i = i + 1) begin
                    b = (k < 0) ? (i == 7) : hb[k][i];
                    if (!b) st = ~st;
                    h_dm = st; h_dp = ~st; #(UB);
                    ones = b ? ones + 1 : 0;
                    if (ones == 6) begin st = ~st; h_dm = st; h_dp = ~st; #(UB); ones = 0; end
                end
            h_dm = 0; h_dp = 0; #(2 * UB);         // SE0
            h_dm = 1; h_dp = 0; #(UB);             // J
            h_oe = 0; h_eop_t = $realtime;
        end
    endtask
    task h_crc(input integer nb);                // append the CRC-16 of hb[1..nb-1] at hb[nb], hb[nb+1]
        integer k, i; reg [15:0] c;
        begin
            c = 16'hFFFF;
            for (k = 1; k < nb; k = k + 1) for (i = 0; i < 8; i = i + 1) c = crc_step(c, hb[k][i]);
            hb[nb] = rev8(~c[15:8]); hb[nb + 1] = rev8(~c[7:0]);
        end
    endtask
    task h_recv(output integer ok);              // one packet from the device, with timeout
        integer nbit, ones, k; reg prev, cur, b; reg [255:0] bits;
        begin
            ok = 0; nbit = 0; ones = 0; prev = 1;
            fork : wt
                begin @(negedge usb_dm); disable wt; end
                begin #(30 * UB); disable wt; end
            join
            if (usb_dm === 1'b0) begin
                d_sop_t = $realtime; ok = 1;
                #(UB / 2);
                while (!(usb_dm === 1'b0 && usb_dp === 1'b0)) begin
                    cur = usb_dm; b = (cur == prev); prev = cur;
                    if (ones == 6) ones = 0;          // stuffed bit: drop
                    else begin bits[nbit] = b; nbit = nbit + 1; ones = b ? ones + 1 : 0; end
                    #(UB);
                end
                r_nb = (nbit - 8) / 8;
                for (k = 0; k < r_nb * 8; k = k + 1) rb_[k / 8][k % 8] = bits[8 + k];
                r_res = 16'hFFFF;
                for (k = 16; k < nbit; k = k + 1) r_res = crc_step(r_res, bits[k]);
                $write("  host got %0d bits:", nbit); for (k = 0; k < nbit; k = k + 1) $write("%0d", bits[k]); $display("");
                #(3 * UB);
            end
        end
    endtask
    // host MCU: drains the receive engine's FIFO while the bus runs
    reg [7:0] urx [0:63], ur_q; integer urx_n = 0; reg urx_on = 0;
    always begin
        wait (urx_on);
        erd(1, 4'hE, ur_q);
        if (!ur_q[3]) begin erd(1, 4'hD, ur_q); urx[urx_n] = ur_q; urx_n = urx_n + 1; end
    end

    // JTAG host-side cycle list
    reg [7:0] jtx [0:17];
    reg [71:0] jtdo;
    reg [7:0] jpat = 8'b1011_0010;
    integer nc;
    task jc(input m, input d); begin
        jtx[nc / 4][2 * (nc % 4) +: 2] = {m, d}; nc = nc + 1;
    end endtask

    // ---------------- WS2812 model: decode pulse widths on pin 0 (T0H 250-550 ns, T1H 650-950 ns)
    reg [47:0] ws_bits; integer ws_n = 0, ws_bad = 0; realtime ws_t, ws_w;
    always @(posedge line[0]) if (ws_sel) ws_t = $realtime;
    always @(negedge line[0]) if (ws_sel) begin
        ws_w = $realtime - ws_t;
        ws_bits = {ws_bits[46:0], ws_w > 600};
        if (!((ws_w >= 250 && ws_w <= 550) || (ws_w >= 650 && ws_w <= 950))) ws_bad = ws_bad + 1;
        ws_n = ws_n + 1;
    end

    // ---------------- 1-Wire device model (pin 5, open drain): presence, Read ROM (0x33)
    reg [63:0] ow_rom; reg [7:0] ow_cmd; reg ow_tx = 0;
    integer ow_bits = 0, ow_k = 0, ow_resets = 0; realtime ow_t;
    function [7:0] crc8(input [55:0] d);         // Dallas/Maxim CRC-8, LSB first
        integer b; reg [7:0] c;
        begin c = 0; for (b = 0; b < 56; b = b + 1) c = ((c[0] ^ d[b]) ? 8'h8C : 8'h00) ^ (c >> 1); crc8 = c; end
    endfunction
    always @(negedge line[5]) if (ow_sel) begin
        ow_t = $realtime;
        if (ow_tx && !ow_rom[ow_k]) begin sl_sda_low = 1; #30000 sl_sda_low = 0; end
    end
    always @(posedge line[5]) if (ow_sel) begin
        if ($realtime - ow_t > 400000) begin
            ow_bits = 0; ow_tx = 0; ow_k = 0; ow_resets = ow_resets + 1;
            #30000 sl_sda_low = 1; #120000 sl_sda_low = 0;            // presence pulse
        end else if (ow_tx) ow_k = ow_k + 1;
        else begin
            ow_cmd = {($realtime - ow_t) < 15000, ow_cmd[7:1]}; ow_bits = ow_bits + 1;
            if (ow_bits == 8 && ow_cmd == 8'h33) begin ow_tx = 1; ow_k = 0; end
        end
    end

    // ---------------- CAN receiver model: 500 kbit/s, hard sync on SOF, destuff, CRC-15, ACK
    reg [127:0] cb; integer c_frames = 0, c_crcok = 0, c_stuffs = 0, c_serr = 0;
    reg [10:0] c_id; reg [3:0] c_dlc; reg [15:0] c_data; reg c_busy = 0;
    integer ck, crun, cnb; reg clast, cbit; reg [14:0] crc_rx;
    function [14:0] crc15(input [127:0] bits, input integer n);
        integer b; reg [14:0] c;
        begin c = 0; for (b = 0; b < n; b = b + 1) c = {c[13:0], 1'b0} ^ ((c[14] ^ bits[b]) ? 15'h4599 : 15'h0); crc15 = c; end
    endfunction
    always @(negedge can_bus) if (can_sel && !c_busy) begin
        c_busy = 1; ck = 0; crun = 0; clast = 1; cnb = 0;
        #1000;
        while (cnb == 0 || ck < cnb) begin
            cbit = can_bus;
            if (crun == 5) begin if (cbit == clast) c_serr = c_serr + 1; c_stuffs = c_stuffs + 1; crun = 1; clast = cbit; end
            else begin
                if (cbit == clast) crun = crun + 1; else begin crun = 1; clast = cbit; end
                cb[ck] = cbit; ck = ck + 1;
                if (ck == 19) begin c_dlc = {cb[15], cb[16], cb[17], cb[18]}; cnb = 19 + 8 * c_dlc + 15; end
            end
            #2000;
        end
        if (crun == 5) begin cbit = can_bus; if (cbit == clast) c_serr = c_serr + 1; c_stuffs = c_stuffs + 1; #2000; end
        for (ck = 0; ck < 11; ck = ck + 1) c_id[10 - ck] = cb[1 + ck];
        c_data = 0;
        for (ck = 0; ck < 8 * c_dlc; ck = ck + 1) c_data[8 * c_dlc - 1 - ck] = cb[19 + ck];
        for (ck = 0; ck < 15; ck = ck + 1) crc_rx[14 - ck] = cb[19 + 8 * c_dlc + ck];
        c_frames = c_frames + 1;
        if (crc_rx == crc15(cb, 19 + 8 * c_dlc) && can_bus === 1'b1) begin   // CRC ok, delimiter recessive
            c_crcok = c_crcok + 1;
            #1000 can_ack = 1; #2000 can_ack = 0;
        end
        #30000 c_busy = 0;
    end

    // ---------------- NRZI / bit stuffing / CRC-16 reference
    real NB = 240.0;                             // 12 clocks per bit
    function [15:0] crc_step(input [15:0] c, input b);
        crc_step = {c[14:0], 1'b0} ^ ((c[15] ^ b) ? 16'h8005 : 16'h0000);
    endfunction
    reg [31:0] n_bits;
    integer n_stuffed;
    task nrzi_decode(input integer nb);          // decode what the engine drives on pin 7
        integer got, ones;
        reg prev, cur, b, skip;
        begin
            got = 0; ones = 0; skip = 0; n_stuffed = 0; n_bits = 0;
            @(line[7]); #(NB / 2); prev = line[7];
            while (got < nb) begin
                #(NB); cur = line[7]; b = ~(cur ^ prev); prev = cur;
                if (skip) begin skip = 0; n_stuffed = n_stuffed + 1; end
                else begin
                    n_bits = {n_bits[30:0], b}; got = got + 1;
                    ones = b ? ones + 1 : 0;
                    if (ones == 6) begin skip = 1; ones = 0; end
                end
            end
        end
    endtask
    task nrzi_send(input [15:0] d, input integer nb);
        integer k, ones;
        begin
            ones = 0;
            tb_nrzi = ~tb_nrzi; #(NB);           // sync transition
            for (k = nb - 1; k >= 0; k = k - 1) begin
                if (!d[k]) tb_nrzi = ~tb_nrzi;
                #(NB);
                ones = d[k] ? ones + 1 : 0;
                if (ones == 6) begin tb_nrzi = ~tb_nrzi; #(NB); ones = 0; end
            end
        end
    endtask

    reg [7:0] q, q2;
    reg [15:0] cref;
    integer k;
    // constrained-random regression (fixed seed, so every run is identical)
    integer seed = 32'h5EA0_2027, it, bad, ne;
    reg [7:0] rb [0:3];
    reg [7:0] rt [0:3];
    real err;
    initial begin
        s_tx[0] = 8'hC5; s_tx[1] = 8'h3A; s_tx[2] = 8'h00; s_tx[3] = 8'h00; s_miso = 1;
        #100 rst_n = 1; #200;

        // ===== host port
        wmark("host port");
        wr(7'h02, 8'hA5); rd(7'h02, q);
        check(q === 8'hA5, "host register write/read");
        check(uo_out[7:2] === 6'b100101, "flags visible on uo_out");

        // ===== UART: engine 0 transmits on pin 0, engine 1 receives on pin 1
        wmark("UART");
        pm_clear;
//@PROG uart_tx 0
//@PROG uart_rx 8
        pm_load;
        wr(7'h07, 8'h01);
        esetup(0, 16'd217, 8'd3, 8'h00, 8'h00, 8'h00, 6'd0, 6'd4, 8'h02, 6'd0);
        esetup(1, 16'd217, 8'd3, 8'h01, 8'h00, 8'h00, 6'd0, 6'd63, 8'h01, 6'd8);
        wr(7'h00, 8'h03);
        fork uart_mon(mon); ecfg(0, 4'hD, 8'h55); join
        check(mon === 8'h55, "UART TX 0x55 at 115200 baud");
        fork uart_mon(mon); ecfg(0, 4'hD, 8'hA3); join
        check(mon === 8'hA3, "UART TX 0xA3 at 115200 baud");
        #(BIT * 2);
        erd(1, 4'hD, q); erd(1, 4'hD, q2);
        check(q === 8'h55 && q2 === 8'hA3, "UART RX loopback 0x55 0xA3");
        urx_sel = 1; #1000;
        uart_send(8'h3C, BIT); uart_send(8'hE1, BIT * 0.97); uart_send(8'h18, BIT * 1.03);
        erd(1, 4'hD, q); check(q === 8'h3C, "UART RX external 0x3C");
        erd(1, 4'hD, q); check(q === 8'hE1, "UART RX 3 percent fast");
        erd(1, 4'hD, q); check(q === 8'h18, "UART RX 3 percent slow");
        erd(1, 4'hE, q); check(q[3] === 1'b1, "UART RX FIFO empty after reads");
        // random bytes, each at a random baud error within +/-3 percent
        bad = 0;
        for (it = 0; it < 40; it = it + 1) begin
            rb[0] = $random(seed);
            err = 1.0 + (($random(seed) % 31) / 1000.0);
            uart_send(rb[0], BIT * err);
            erd(1, 4'hD, q);
            if (q !== rb[0]) bad = bad + 1;
        end
        check(bad == 0, "UART RX 40 random bytes, random baud");

        // ===== SPI master: engine 2, SCK pin 2, MOSI pin 3, MISO pin 4
        wmark("SPI master");
        pm_clear;
//@PROG spi_master 0
        pm_load;
        wr(7'h08, 8'hFB); wr(7'h07, 8'h0C);
        s_bits = 0;                              // ignore power-up edges on the idle pin
        esetup(2, 16'd5, 8'd0, 8'h1C, 8'h10, 8'h00, 6'd0, 6'd1, 8'h0C, 6'd0);
        wr(7'h00, 8'h04);
        ecfg(2, 4'hD, 8'h9E); ecfg(2, 4'hD, 8'h71);
        #20000;
        check(s_rx[0] === 8'h9E && s_rx[1] === 8'h71, "SPI MOSI bytes 0x9E 0x71");
        erd(2, 4'hD, q); erd(2, 4'hD, q2);
        check(q === 8'hC5 && q2 === 8'h3A, "SPI MISO bytes 0xC5 0x3A");
        check(s_bits == 16 && line[2] === 1'b0, "SPI 16 clocks, SCK idles low");
        // random full-duplex bursts: 4 random bytes each way, back to back
        bad = 0;
        for (it = 0; it < 12; it = it + 1) begin
            for (ne = 0; ne < 4; ne = ne + 1) begin rb[ne] = $random(seed); rt[ne] = $random(seed); s_tx[ne] = rt[ne]; end
            s_bits = 0; s_miso = rt[0][7];
            for (ne = 0; ne < 4; ne = ne + 1) ecfg(2, 4'hD, rb[ne]);
            #14000;
            for (ne = 0; ne < 4; ne = ne + 1) begin
                erd(2, 4'hD, q);
                if (s_rx[ne] !== rb[ne] || q !== rt[ne]) bad = bad + 1;
            end
        end
        check(bad == 0, "SPI 48 random bytes each way");
        // SPI modes 1-3: 4 random bytes each way per mode, SCK idle level checked
        pm_clear;
//@PROG spi_mode2 2
//@PROG spi_mode1 4
//@PROG spi_mode3 9
        pm_load;
        for (it = 1; it < 4; it = it + 1) begin
            wr(7'h00, 8'h00);
            s_mode = it; wr(7'h08, it[1] ? 8'hFF : 8'hFB);
            if (it == 2) esetup(2, 16'd5, 8'd0, 8'h1C, 8'h10, 8'h00, 6'd2, 6'd3, 8'h0C, 6'd2);
            else if (it == 1) esetup(2, 16'd5, 8'd0, 8'h1C, 8'h10, 8'h00, 6'd4, 6'd8, 8'h04, 6'd4);
            else esetup(2, 16'd5, 8'd0, 8'h1C, 8'h10, 8'h00, 6'd9, 6'd13, 8'h04, 6'd9);
            for (ne = 0; ne < 4; ne = ne + 1) begin rb[ne] = $random(seed); rt[ne] = $random(seed); s_tx[ne] = rt[ne]; end
            #200; s_bits = 0; s_miso = rt[0][7];
            wr(7'h00, 8'h04);
            for (ne = 0; ne < 4; ne = ne + 1) ecfg(2, 4'hD, rb[ne]);
            #20000;
            bad = 0;
            for (ne = 0; ne < 4; ne = ne + 1) begin
                erd(2, 4'hD, q);
                if (s_rx[ne] !== rb[ne] || q !== rt[ne]) bad = bad + 1;
            end
            if (s_bits != 32 || line[2] !== it[1]) bad = bad + 1;
            check(bad == 0, it == 1 ? "SPI mode 1: 4 random bytes each way" :
                            it == 2 ? "SPI mode 2: 4 random bytes each way" :
                                      "SPI mode 3: 4 random bytes each way");
        end
        wr(7'h00, 8'h00); s_mode = 0;

        // ===== I2C master: engine 3, open-drain SDA pin 5, SCL pin 6
        wmark("I2C master");
        pm_clear;
//@PROG i2c_master 0
        pm_load;
        wr(7'h08, 8'hFF); wr(7'h06, 8'h60); wr(7'h07, 8'h60);
        esetup(3, 16'd32, 8'd0, 8'h2D, 8'h35, 8'h08, 6'd0, 6'd63, 8'h00, 6'd0);   // 390 kHz
        wr(7'h00, 8'h08);
        ecfg(3, 4'hD, 8'h01); ecfg(3, 4'hD, 8'hA6); ecfg(3, 4'hD, 8'h5D);
        #120000;
        check(i_n == 2 && i_rx[0] === 8'hA6 && i_rx[1] === 8'h5D, "I2C 400k write bytes 0xA6 0x5D");
        erd(3, 4'hD, q); erd(3, 4'hD, q2);
        check(q === 8'h00 && q2 === 8'h01, "I2C ACK then NACK captured");
        check(i_stretches == 2 && i_stop === 1'b1, "I2C clock stretch and STOP");
        check(sda === 1'b1 && scl === 1'b1, "I2C bus released");
        // I2C read at 100 kHz: address 0x53 + R, 3 bytes, master ACK ACK NACK
        wr(7'h00, 8'h00);
        pm_clear;
//@PROG i2c_read 0
        pm_load;
        i_dat[0] = 8'h3C; i_dat[1] = 8'hF0; i_dat[2] = 8'h81;
        i_n = 0; i_k = 0; i_rd = 0; i_stop = 0; i_mack = 4'hF;
        esetup(3, 16'd125, 8'd0, 8'h2D, 8'h35, 8'h08, 6'd0, 6'd32, 8'h00, 6'd0);
        wr(7'h00, 8'h08);
        ecfg(3, 4'hD, 8'h02); ecfg(3, 4'hD, 8'hA7);
        #500000;
        erd(3, 4'hD, q); check(q === 8'h00 && i_rx[0] === 8'hA7, "I2C read: address 0xA7 ACKed");
        erd(3, 4'hD, q); erd(3, 4'hD, q2); erd(3, 4'hD, mon);
        check(q === 8'h3C && q2 === 8'hF0 && mon === 8'h81, "I2C 100k read 0x3C 0xF0 0x81");
        check(i_k == 3 && i_mack[2:0] === 3'b100, "I2C read: master ACK ACK NACK");
        check(i_stop === 1'b1 && sda === 1'b1 && scl === 1'b1, "I2C read: STOP, bus released");

        // ===== NRZI + bit stuffing + CRC-16: engine 0 transmits, engine 1 receives, pin 7
        wmark("NRZI + bit stuffing + CR");
        pm_clear;
//@PROG nrzi_tx 0
//@PROG nrzi_rx 32
        pm_load;
        wr(7'h06, 8'h00); wr(7'h08, 8'hFF); wr(7'h07, 8'h80);
        esetup(0, 16'd4, 8'd0, 8'h38, 8'h00, 8'h00, 6'd0, 6'd63, 8'h08, 6'd0);
        ecfg(0, 4'hA, 8'hF6); ecfg(0, 4'hB, 8'h05); ecfg(0, 4'hC, 8'h80);
        wr(7'h00, 8'h01);
        ecfg(0, 4'hD, 8'd31);
        #2000;
        ecfg(0, 4'hD, 8'hFF); ecfg(0, 4'hD, 8'hFF); ecfg(0, 4'hD, 8'h7E); ecfg(0, 4'hD, 8'h81);
        fork nrzi_decode(32); wr(7'h02, 8'h80); join
        check(n_bits === 32'hFFFF7E81, "NRZI TX data decoded by reference");
        check(n_stuffed == 3, "NRZI TX inserted 3 stuffed bits");
        #3000;
        cref = 16'hFFFF;
        for (k = 31; k >= 0; k = k - 1) cref = crc_step(cref, n_bits[k]);
        erd(0, 4'hD, q); erd(0, 4'hD, q2);
        check({q2, q} === cref, "CRC-16 of TX matches reference");
        rd(7'h02, q); check(q[0] === 1'b1, "TX done flag raised");

        nrzi_sel = 1; wr(7'h07, 8'h00);
        esetup(1, 16'd4, 8'd0, 8'h07, 8'h00, 8'h00, 6'd0, 6'd63, 8'h24, 6'd32);
        ecfg(1, 4'hA, 8'hF6); ecfg(1, 4'hB, 8'h05); ecfg(1, 4'hC, 8'h80);
        wr(7'h00, 8'h02);
        ecfg(1, 4'hD, 8'd15);
        #2000;
        nrzi_send(16'hFF7E, 16);
        #3000;
        cref = 16'hFFFF;
        for (k = 15; k >= 0; k = k - 1) cref = crc_step(cref, (16'hFF7E >> k) & 1'b1);
        erd(1, 4'hD, q); erd(1, 4'hD, q2);
        check(q === 8'hFF && q2 === 8'h7E, "NRZI RX destuffed 0xFF 0x7E");
        erd(1, 4'hD, q); erd(1, 4'hD, q2);
        check({q2, q} === cref, "CRC-16 of RX matches reference");
        rd(7'h01, q); check(q === 8'h00, "no FIFO overruns, no IRQs");

        // ===== JTAG: engine 0, TCK pin 0, TDI pin 1, TMS pin 2, TDO pin 4
        wmark("JTAG");
        wr(7'h00, 8'h00);
        pm_clear;
//@PROG jtag 0
//@PROG swd_read 8
        pm_load;
        jtag_sel = 1; wr(7'h08, 8'h00); wr(7'h07, 8'h07); #200; tap = 0;
        // cycle list {TMS, TDI}: reset, IDCODE DR scan, IR scan (BYPASS), 8-bit DR scan via bypass
        nc = 0;
        for (ne = 0; ne < 5; ne = ne + 1) jc(1, 0);
        jc(0, 0);
        jc(1, 0); jc(0, 0); jc(0, 0);
        for (ne = 0; ne < 32; ne = ne + 1) jc(ne == 31, 0);
        jc(1, 0); jc(0, 0);
        jc(1, 0); jc(1, 0); jc(0, 0); jc(0, 0);
        for (ne = 0; ne < 4; ne = ne + 1) jc(ne == 3, 1);
        jc(1, 0); jc(0, 0);
        jc(1, 0); jc(0, 0); jc(0, 0);
        for (ne = 0; ne < 8; ne = ne + 1) jc(ne == 7, jpat[ne]);
        jc(1, 0); jc(0, 0);
        while (nc < 72) jc(0, 0);
        esetup(0, 16'd5, 8'd0, 8'h0C, 8'h00, 8'h00, 6'd0, 6'd4, 8'h0B, 6'd0);
        wr(7'h00, 8'h01);
        for (it = 0; it < 9; it = it + 1) begin
            ecfg(0, 4'hD, jtx[2 * it]); ecfg(0, 4'hD, jtx[2 * it + 1]);
