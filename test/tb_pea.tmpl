        check(jtdo[50:47] === 4'b0001 && ir === 4'hF, "JTAG IR scan: capture 0001, BYPASS");
        check(jtdo[56] === 1'b0 && jtdo[63:57] === jpat[6:0], "JTAG 8 bits through BYPASS");
        check(tap === 4'd1 && line[0] === 1'b0, "JTAG back in Run-Test/Idle");
        wr(7'h00, 8'h00); jtag_sel = 0;

        // ===== SWD read: engine 1, SWCLK pin 0, SWDIO pin 1
        wmark("SWD read");
        swd_sel = 1; wr(7'h08, 8'h02); wr(7'h07, 8'h03); #200; sw_r = 0;
        esetup(1, 16'd5, 8'd0, 8'h09, 8'h01, 8'h08, 6'd8, 6'd28, 8'h03, 6'd8);
        wr(7'h00, 8'h02);
        ecfg(1, 4'hD, 8'hA5);                    // DPIDR read: start, DP, read, A=0, parity, stop, park
        #12000;
        erd(1, 4'hD, q); erd(1, 4'hD, q2);
        check(sw_req === 8'hA5 && q[7:5] === 3'b001, "SWD request 0xA5, ACK OK");
        erd(1, 4'hD, mon); jtdo[7:0] = q2; jtdo[15:8] = mon;
        #4000; erd(1, 4'hD, q); erd(1, 4'hD, q2); jtdo[23:16] = q; jtdo[31:24] = q2;
        #4000; erd(1, 4'hD, q);
        check(jtdo[31:0] === SWD_DATA, "SWD read data 0x2BA01477");
        check(q[7] === ^SWD_DATA && sw_r == 45, "SWD parity and turnaround");
        wr(7'h00, 8'h00); swd_sel = 0;
        rd(7'h01, q); check(q === 8'h00, "JTAG/SWD: no FIFO overruns");
        // ===== concurrency: all four engines at once (UART TX -> UART RX loopback, SPI, I2C)
        wmark("concurrency");
        wr(7'h00, 8'h00);
        pm_clear;
//@PROG uart_tx 0
//@PROG uart_rx 8
//@PROG spi_master 16
//@PROG i2c_master 24
        pm_load;
        wr(7'h08, 8'hFB); wr(7'h06, 8'h60); wr(7'h07, 8'h6D); #200;
        urx_sel = 0; s_bits = 0; s_mode = 0; s_tx[0] = 8'h96; s_tx[1] = 8'h0F; s_miso = 1;
        i_n = 0; i_rd = 0; i_stop = 0; i_stretches = 0;
        esetup(0, 16'd217, 8'd3, 8'h00, 8'h00, 8'h00, 6'd0, 6'd4, 8'h02, 6'd0);
        esetup(1, 16'd217, 8'd3, 8'h01, 8'h00, 8'h00, 6'd8, 6'd13, 8'h01, 6'd8);
        esetup(2, 16'd5, 8'd0, 8'h1C, 8'h10, 8'h00, 6'd16, 6'd17, 8'h0C, 6'd16);
        esetup(3, 16'd32, 8'd0, 8'h2D, 8'h35, 8'h08, 6'd24, 6'd41, 8'h00, 6'd24);
        ecfg(0, 4'hD, 8'h5A); ecfg(2, 4'hD, 8'hE4); ecfg(2, 4'hD, 8'h1B);
        ecfg(3, 4'hD, 8'h01); ecfg(3, 4'hD, 8'hA6); ecfg(3, 4'hD, 8'h5D);
        wr(7'h00, 8'h0F);                        // start all four engines together
